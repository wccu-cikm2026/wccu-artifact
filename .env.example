# Copy this file to .env and fill in exactly one provider configuration.
# The harness auto-loads .env from the current directory, a parent directory,
# or the repository root. You can override the path with PCSE_ENV_FILE.

# OpenAI Responses API
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# OPENAI_BASE_URL=https://api.openai.com/v1

# Gemini API
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-1.5-flash
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# OpenAI-compatible local/remote endpoint
# LLM_PROVIDER=openai-compatible
# LLM_MODEL=your-model
# OPENAI_COMPATIBLE_API_KEY=YOUR_OPENAI_COMPATIBLE_API_KEY
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1

# Optional multi-model robustness sweep. Comma-separated provider:model specs.
# Used by: python -m wccu_eval.eval.run_multi_model_obligation_benchmark
# LLM_MODELS=openai:gpt-4.1-mini,gemini:gemini-1.5-flash
